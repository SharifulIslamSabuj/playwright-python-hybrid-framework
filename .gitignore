# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- pytest ---
.pytest_cache/
.cache/

# --- Playwright ---
# Downloaded browser binaries live outside the repo (~/AppData/Local/ms-playwright
# on Windows / ~/.cache/ms-playwright on Linux/macOS), never inside it.
test-results/
playwright-report/
.playwright/

# --- Generated reports / execution artifacts (docs/11 §33: gitignored, output only) ---
reports/html/*
reports/screenshots/*
reports/traces/*
reports/videos/*
# reports/artifacts/ is pytest-playwright's actual --output directory
# (pyproject.toml addopts) — was missing here, so screenshot/trace evidence
# under it was never actually gitignored despite being generated output.
reports/artifacts/*
# reports/allure-results/ — raw Allure result collection (Phase 1), same
# generated-output-only treatment as the directories above.
reports/allure-results/*
# reports/allure-report/ — the generated static Allure HTML site (Phase 3),
# same generated-output-only treatment. Was missing here since Phase 3
# only validated local generation and didn't touch .gitignore.
reports/allure-report/*
!reports/html/.gitkeep
!reports/screenshots/.gitkeep
!reports/traces/.gitkeep
!reports/videos/.gitkeep
!reports/artifacts/.gitkeep
!reports/allure-results/.gitkeep
!reports/allure-report/.gitkeep

# --- Environment / secrets (docs/11 §37: never committed) ---
.env
.env.local
.env.*.local

# --- IDEs / editors ---
.vscode/
.idea/
*.swp
*.swo

# --- OS-generated files ---
.DS_Store
Thumbs.db
desktop.ini
