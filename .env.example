# Environment variable template for playwright-python-hybrid-framework.
# Copy this file to `.env` and adjust values as needed for local execution.
# `.env` itself is gitignored and must never be committed.
#
# No API key, token, or session credential is required by the AUT
# (see docs/02-Application-Analysis.md §10) — the variables below are
# execution configuration, not application secrets. Any real credential
# introduced in the future (e.g., a CI reporting token) must be added
# here as a placeholder key only, per docs/11-Framework-Architecture.md §37.

# --- Application under test ---
AUT_BASE_URL=https://automationexercise.com
API_BASE_URL=https://automationexercise.com

# --- Browser execution ---
# One of: chromium, firefox, webkit
BROWSER=chromium
HEADLESS=true

# --- Timeouts (milliseconds) ---
DEFAULT_TIMEOUT_MS=30000
EXPECT_TIMEOUT_MS=5000

# --- Retry / execution behavior ---
# Local development default is 0 (see docs/10-Automation-Strategy.md §16);
# CI overrides this to a small bounded value at the pipeline level.
RETRIES=0
WORKERS=1

# --- Reporting ---
REPORT_DIR=reports

# --- Durable test accounts (docs/08-Test-Data.md §7: TD-USER-VALID-001, TD-USER-EXISTING-001) ---
# These accounts must be provisioned once, outside routine test execution,
# per docs/09-Automation-Scope.md §12 and §30 item 4. Left blank until
# QA-Lead-authorized provisioning occurs — no value is invented here.
DURABLE_VALID_USER_EMAIL=
DURABLE_VALID_USER_PASSWORD=
DURABLE_EXISTING_USER_EMAIL=

# --- Account creation/deletion execution gate (AE-UI-TC-004, AE-API-TC-011/012) ---
# Separate from the durable-account values above: this gate covers actually
# CREATING or DELETING an account, not reading/logging into one that already
# exists. Left false until a human operator explicitly sets it in their own
# environment, per docs/09-Automation-Scope.md §12/§30 item 4 and
# docs/07-Test-Cases.md AE-API-TC-011. This project's AI assistant never
# sets this value itself.
ACCOUNT_CREATION_EXECUTION_AUTHORIZED=
